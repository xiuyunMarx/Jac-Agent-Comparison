# Postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=

# Django
DJANGO_SECRET_KEY=""
DEBUG=False

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# OpenAI (https://platform.openai.com/) - default provider for the agent models
OPENAI_API_KEY=

# Groq (https://console.groq.com/) - only needed if you point INSTANT_LLM /
# POWERFUL_LLM at Groq models (e.g. INSTANT_LLM=groq:llama-3.1-8b-instant)
GROQ_API_KEY=

# Langsmith (optional: Activate Langsmith tracing see: https://smith.langchain.com/)
LANGSMITH_TRACING=True
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="YT Navigator"

# Benchmark (see benchmark/README.md)
# Disables LangSmith example collection for reproducible headless runs.
# The `benchmark_run` command forces this on for its own process automatically.
BENCHMARK_MODE=False
# Pin the models explicitly when benchmarking so all runs/implementations match.
# Plain names are OpenAI models; "provider:name" selects another provider.
# INSTANT_LLM=gpt-4o-mini
# POWERFUL_LLM=gpt-4o
