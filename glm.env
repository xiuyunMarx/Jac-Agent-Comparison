# Shared model seam for every benchmark arm: GLM 5.2 on ollama cloud through
# its OpenAI-compatible endpoint.  Usage:  set -a; source glm.env; set +a
#
# BENCH_MODEL is the bare model id; each arm adds the shape its library wants
# (litellm: openai/<id>, raw SDK / LangChain: <id>).  The key comes from .env.
source "$(dirname "${BASH_SOURCE[0]}")/.env"
export BENCH_MODEL="${BENCH_MODEL:-glm-5.2}"
export OPENAI_API_KEY="${OLLAMA_API_KEY}"
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-https://ollama.com/v1}"
export OPENAI_API_BASE="${OPENAI_BASE_URL}"          # litellm's spelling
export PROXY_UPSTREAM="${PROXY_UPSTREAM:-https://ollama.com}"   # RagGPT token proxy
export CODEAGENT_MODEL="${CODEAGENT_MODEL:-openai/${BENCH_MODEL}}"  # CodeAgent arms
